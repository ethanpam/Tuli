{
  "name": "tuli",
  "version": "1.0.0",
  "description": "Community Discord bot",
  "scripts": {
    "dev": "tsx watch --env-file=.env --disable-warning=ExperimentalWarning src/index.ts",
    "start": "tsx --env-file=.env --disable-warning=ExperimentalWarning src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "DATABASE_PATH=:memory: tsx --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethanpam/Tuli.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/ethanpam/Tuli/issues"
  },
  "homepage": "https://github.com/ethanpam/Tuli#readme",
  "dependencies": {
    "croner": "^10.0.1",
    "discord.js": "^14.27.0",
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
