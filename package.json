{
  "name": "tuli",
  "description": "Community Discord bot",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/index.ts",
    "start": "tsx --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "DATABASE_PATH=:memory: tsx --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "check": "npm run typecheck && npm test && prettier --check src test",
    "format": "prettier --write src test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethanpam/Tuli.git"
  },
  "type": "module",
  "dependencies": {
    "croner": "^10.0.1",
    "discord.js": "^14.27.0",
    "fast-xml-parser": "^5.11.2",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true
}
