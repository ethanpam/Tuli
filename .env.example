# Get this from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional: where to keep Tuli's database (default: data/tuli.db). On a host, point this at persistent storage.
# DATABASE_PATH=/data/tuli.db

# Optional: lets members chat with Tuli. Get a free key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Optional: which Gemini model to use (default: gemini-3.5-flash-lite). gemini-3.8-flash is smarter but has lower free limits.
# GEMINI_MODEL=
